# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
# PORT is only used for local development — Netlify does not need this
PORT=5001

# ── Database ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/rapidbuilt
# Production (Netlify): mongodb+srv://<user>:<pass>@cluster.mongodb.net/rapidbuilt?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Client & CORS ────────────────────────────────────────────────────────
# Production (Netlify): set to your deployed frontend URL
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Example for production:
# CLIENT_URL=https://pragati-frontend.netlify.app
# CORS_ORIGINS=https://pragati-frontend.netlify.app

# ── Encryption (AES-256-GCM, 64 hex chars = 32 bytes) ───────────────────
ENCRYPTION_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90123456789abcdef0123456789abcdef0

# ── Email (Nodemailer — Optional) ────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_smtp_key_here
EMAIL_FROM=noreply@rapidbuilt.gov.in

# ── Monitoring (Optional) ────────────────────────────────────────────────
SENTRY_DSN=

# ── PAiMANA / MoSPI ──────────────────────────────────────────────────────
PAIMANA_PORTAL_URL=https://paimana-proj.mospi.gov.in
PAIMANA_TIMEOUT_MS=15000
PAIMANA_MOCK_ENABLED=true
# PAIMANA_BASE_URL=
# PAIMANA_API_KEY=

# ── AI Assistant (server-side only — never exposed to the frontend) ────────
AI_PROVIDER=gemini
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# OpenAI (leave blank if using Gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ════════════════════════════════════════════════════════════════════════════
# NETLIFY REQUIRED ENVIRONMENT VARIABLES
# Set ALL of the following in: Netlify → Site Settings → Environment Variables
# ════════════════════════════════════════════════════════════════════════════
#
# NODE_ENV              = production
# MONGODB_URI           = mongodb+srv://...  (your Atlas connection string)
# JWT_ACCESS_SECRET     = (same as local — keep secret)
# JWT_REFRESH_SECRET    = (same as local — keep secret)
# JWT_ACCESS_EXPIRES_IN = 15m
# JWT_REFRESH_EXPIRES_IN = 7d
# ENCRYPTION_KEY        = (same as local — keep secret)
# CLIENT_URL            = https://your-frontend.netlify.app
# CORS_ORIGINS          = https://your-frontend.netlify.app
# AI_PROVIDER           = gemini
# GEMINI_API_KEY        = (your Gemini key)
# GEMINI_MODEL          = gemini-2.0-flash
# PAIMANA_PORTAL_URL    = https://paimana-proj.mospi.gov.in
# PAIMANA_TIMEOUT_MS    = 15000
# PAIMANA_MOCK_ENABLED  = true
#
# OPTIONAL:
# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / EMAIL_FROM  (for email)
# SENTRY_DSN  (for error monitoring)
